# Copy to .env and `chmod 600 .env`. Values are literal: no shell expansion.
#
# Build
IMAGE_REPOSITORY=dsh-api-runtime
# Leave empty to tag with the pinned @deepseek-ai/dsh version (recommended:
# keeps .env.example from drifting after scripts/update-dsh.sh).
IMAGE_TAG=
NODE_IMAGE=node:24-trixie
NODE_IMAGE_DIGEST=
RUNTIME_IMAGE=node:24-trixie-slim
RUNTIME_IMAGE_DIGEST=

# Runtime
CONTAINER_NAME=dsh-api
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
ALLOW_UNAUTHENTICATED_EXPOSURE=0
DSH_HOME_VOLUME=dsh-api-home
WORKSPACE_HOST=/srv/dsh-workspace
WORKSPACE=/workspace
DSH_CWD=/workspace

# Provider/model (verified against @deepseek-ai/dsh 0.2.2-rc.3)
DSH_PROVIDER=deepseek-official
DSH_MODEL=deepseek-v4-flash
DSH_REASONING_EFFORT=
DSH_MAX_TOKENS=

# Model credentials. Never commit this file.
DEEPSEEK_API_KEY=replace-me

# Bridge behavior
INIT_TIMEOUT_MS=60000
RPC_TIMEOUT_MS=300000
MAX_INFLIGHT=16
MAX_BODY_BYTES=8388608
ENABLE_APPROVALS=0
ENABLE_USER_QUESTIONS=0

# Container resources
MEMORY_LIMIT=2g
CPU_LIMIT=2

# Telemetry
LOG_LEVEL=info
DSH_TELEMETRY_MODE=DISABLED

