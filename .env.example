# Copy to .env and `chmod 600 .env`. Values are plain shell assignments.

# Where the API is reachable and what it is called.
# 0.0.0.0 publishes on every host interface. The API has no authentication,
# so anyone who can reach this host can use it; set 127.0.0.1 to keep it local.
BIND_ADDRESS=0.0.0.0
HTTP_PORT=3080
WEB_PORT=8080
ALLOW_UNAUTHENTICATED_EXPOSURE=1

# Image
IMAGE_REPOSITORY=dsh-api-runtime
# Leave empty to tag with the pinned @deepseek-ai/dsh version.
IMAGE_TAG=

# Host folder DSH may read and write, exposed as WORKSPACE in the container.
WORKSPACE_HOST=/srv/dsh-workspace
WORKSPACE=/workspace
DSH_CWD=/workspace

# Optional: the folder that holds your projects. It is mounted at the SAME
# absolute path inside the container, so a path you pick in DSH (a workspace,
# a session's working directory) also exists on your host. Leave empty to skip.
PROJECTS_PATH=

# Host Docker socket, mounted into the container so the agent can run docker
# commands. This gives the container control of the host Docker daemon.
DOCKER_SOCKET=/var/run/docker.sock

# Model
DSH_PROVIDER=deepseek-official
DSH_MODEL=deepseek-v4-flash
DSH_REASONING_EFFORT=
DSH_MAX_TOKENS=
DEEPSEEK_API_KEY=replace-me

# Optional: GitHub token for gh and git inside the container. Every value in
# this file is passed to the container with --env-file, so this becomes a
# GH_TOKEN environment variable there. Prefer `docker exec -it dsh gh auth
# login`, which stores the token in the DSH home volume instead of this file.
# GH_TOKEN=github_pat_replace-me

# Limits and logging
MEMORY_LIMIT=12g
CPU_LIMIT=2
LOG_LEVEL=info
DSH_TELEMETRY_MODE=DISABLED

# Persistent DSH home volume (sessions, credentials cache).
DSH_HOME_VOLUME=dsh-api-home
