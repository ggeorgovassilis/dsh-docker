# syntax=docker/dockerfile:1.7

# Tool-enabled extension of the base DSH runtime. This image is selected only
# by scripts/run.sh. Tool-specific configuration and credential storage
# are intentionally kept out of the base image and the DSH bridge.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

USER root

RUN apt-get update \
 && apt-get install --yes --no-install-recommends \
      docker-buildx \
      docker-cli \
      gh \
      git \
      openssh-client \
      ripgrep \
      procps \
 && rm -rf /var/lib/apt/lists/*

# Tool state and credentials live in a dedicated tools volume mounted by the
# tools wrapper at /home/node/.tools. This image deliberately does not define
# GH_CONFIG_DIR, GIT_CONFIG_GLOBAL or DOCKER_CONFIG; the wrapper sets those
# non-secret paths explicitly.
RUN mkdir -p /home/node/.tools \
 && chown node:node /home/node/.tools

USER node
WORKDIR /workspace

ARG IMAGE_VERSION=dev
ARG IMAGE_REVISION=unknown
LABEL org.opencontainers.image.title="DSH API Runtime with tools" \
      org.opencontainers.image.description="DSH API runtime extended with agent-facing CLI tools" \
      org.opencontainers.image.version="${IMAGE_VERSION}" \
      org.opencontainers.image.revision="${IMAGE_REVISION}" \
      io.example.dsh.variant="tools"
